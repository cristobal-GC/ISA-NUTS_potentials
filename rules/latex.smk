    shell:
        (
            "python scripts/get_tex_table_summary.py "
            "--cutout {wildcards.cutout} "
            "--year {wildcards.year} "
            "--nuts {wildcards.nuts} "
            "--resource {wildcards.resource} "
            "--output {output.tex_table_summary}"
        )


#################### get_tex_DECK
#
# This rule builds a DECK PDF by concatenating:
#   1) cover_{nuts}.pdf
#   2) NUTS_{nuts}.pdf
#   3) all summary PDFs for that NUTS level in alphabetical order
#   4) Venn_{nuts}.pdf
#
# Wildcards:
#   - cutout     [era5, ...]
#   - year       [2013, ...]
#   - resource   [onwind, solar]
#   - nuts       [NUTS2, NUTS3]

rule get_tex_DECK:
    wildcard_constraints:
        nuts="NUTS2|NUTS3",
        resource="onwind|solar",
    threads:
        lambda w: get_rule_threads(
            "get_tex_DECK",
            f"benchmarks/get_tex_DECK/{w.cutout}/{w.resource}/{w.nuts}/get_tex_DECK_{w.nuts}_{w.year}.tsv",
        )
    resources:
        mem_mb=lambda w: get_rule_mem_mb(
            "get_tex_DECK",
            f"benchmarks/get_tex_DECK/{w.cutout}/{w.resource}/{w.nuts}/get_tex_DECK_{w.nuts}_{w.year}.tsv",
        )
    benchmark:
        "benchmarks/get_tex_DECK/{cutout}/{resource}/{nuts}/get_tex_DECK_{nuts}_{year}.tsv"
    message:
        "... [get_tex_DECK] Building DECK PDF for cutout: {wildcards.cutout}, year: {wildcards.year}, resource: {wildcards.resource}, NUTS level: {wildcards.nuts}."
    input:
        cover_pdf="results/LaTex/{cutout}/{year}/{resource}/{nuts}/cover_{nuts}.pdf",
        nuts_pdf="results/LaTex/{cutout}/{year}/{resource}/{nuts}/NUTS_{nuts}.pdf",
        summary_pdfs=lambda w: [
            f"results/LaTex/{w.cutout}/{w.year}/{w.resource}/{w.nuts}/summary_{region}_{resolution}.pdf"
            for region in sorted({r for n, r in REGION_NUTS_PAIRS if n == w.nuts})
            for resolution in sorted(RESOLUTIONS)
        ],
        venn_pdf="results/LaTex/{cutout}/{year}/{resource}/{nuts}/Venn_{nuts}.pdf",
    output:
        deck_pdf="results/LaTex/{cutout}/{year}/{resource}/{nuts}/DECK_{nuts}.pdf"
    shell:
        (
            "python scripts/get_tex_DECK.py "
            "--output {output.deck_pdf} "
            "{input.cover_pdf} "
            "{input.nuts_pdf} "
            "{input.summary_pdfs} "
            "{input.venn_pdf}"
        )
