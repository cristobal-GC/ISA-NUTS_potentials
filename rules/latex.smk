#################### get_tex_Venn
#
# This rule generates a LaTeX file with the Venn-diagrams figure for a given
# NUTS level.
#
# Wildcards:
#   - cutout     [era5, ...]
#   - year       [2013, ...]
#   - resource   [onwind, solar]
#   - nuts       [NUTS2, NUTS3]

rule get_tex_Venn:
    wildcard_constraints:
        nuts="NUTS2|NUTS3",
        resource="onwind|solar",
    threads:
        lambda w: get_rule_threads(
            "get_tex_Venn",
            f"benchmarks/get_tex_Venn/{w.cutout}/{w.resource}/{w.nuts}/get_tex_Venn_{w.nuts}_{w.year}.tsv",
        )
    resources:
        mem_mb=lambda w: get_rule_mem_mb(
            "get_tex_Venn",
            f"benchmarks/get_tex_Venn/{w.cutout}/{w.resource}/{w.nuts}/get_tex_Venn_{w.nuts}_{w.year}.tsv",
        )
    benchmark:
        "benchmarks/get_tex_Venn/{cutout}/{resource}/{nuts}/get_tex_Venn_{nuts}_{year}.tsv"
    message:
        "... [get_tex_Venn] Generating Venn LaTeX file for cutout: {wildcards.cutout}, year: {wildcards.year}, resource: {wildcards.resource}, NUTS level: {wildcards.nuts}."
    input:
        template=lambda w: (
            "LaTex/template_Venn_onwind.tex"
            if w.resource == "onwind"
            else f"LaTex/template_Venn_{w.resource}.tex"
        ),
        venn_fig="results/figs/venn_all/{cutout}/{nuts}/venn_all_{resource}_{year}.pdf"
    output:
        tex_venn="results/LaTex/{cutout}/{year}/{resource}/{nuts}/Venn_{nuts}.tex"
    shell:
        (
            "python scripts/get_tex_Venn.py "
            "--nuts {wildcards.nuts} "
            "--cutout {wildcards.cutout} "
            "--year {wildcards.year} "
            "--resource {wildcards.resource} "
            "--template {input.template}"
        )


