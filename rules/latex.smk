#################### get_tex_table_ISA
#
# This rule generates a LaTeX table with ISA surface distribution by region
# for one NUTS level and resource.
#
# Wildcards:
#   - nuts       [NUTS2, NUTS3]
#   - resource   [onwind, solar]

rule get_tex_table_ISA:
    wildcard_constraints:
        nuts="NUTS2|NUTS3",
        resource="onwind|solar",
    threads:
        lambda w: get_rule_threads(
            "get_tex_table_ISA",
            f"benchmarks/get_tex_table_ISA/{w.resource}/{w.nuts}/get_tex_table_ISA_{w.resource}_{w.nuts}.tsv",
        )
    resources:
        mem_mb=lambda w: get_rule_mem_mb(
            "get_tex_table_ISA",
            f"benchmarks/get_tex_table_ISA/{w.resource}/{w.nuts}/get_tex_table_ISA_{w.resource}_{w.nuts}.tsv",
        )
    benchmark:
        "benchmarks/get_tex_table_ISA/{resource}/{nuts}/get_tex_table_ISA_{resource}_{nuts}.tsv"
    message:
        "... [get_tex_table_ISA] Generating ISA table LaTeX for resource: {wildcards.resource}, NUTS level: {wildcards.nuts}."
    input:
        dfs=lambda w: [
            f"results/dfs/ISA/{w.nuts}/df_ISA_{w.resource}_{region}.csv"
            for nuts, region in REGION_NUTS_PAIRS
            if nuts == w.nuts
        ],
        nuts_geojson="data/NUTS/NUTS_RG_01M_2021_4326_ES.geojson",
    output:
        tex_table_isa="results/LaTex/tables/ISA/{nuts}/table_ISA_{resource}_{nuts}.tex"
    shell:
        (
            "python scripts/get_tex_table_ISA.py "
            "--nuts {wildcards.nuts} "
            "--resource {wildcards.resource} "
            "--output {output.tex_table_isa}"
        )


#################### get_tex_table_summary
