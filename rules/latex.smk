            f"benchmarks/compile_tex_NUTS/{w.cutout}/{w.resource}/{w.nuts}/compile_tex_NUTS_{w.nuts}_{w.year}.tsv",
        )
    benchmark:
        "benchmarks/compile_tex_NUTS/{cutout}/{resource}/{nuts}/compile_tex_NUTS_{nuts}_{year}.tsv"
    message:
        "... [compile_tex_NUTS] Compiling PDF for cutout: {wildcards.cutout}, year: {wildcards.year}, resource: {wildcards.resource}, NUTS level: {wildcards.nuts}."
    input:
        tex_nuts="results/LaTex/{cutout}/{year}/{resource}/{nuts}/NUTS_{nuts}.tex"
    output:
        pdf_nuts="results/LaTex/{cutout}/{year}/{resource}/{nuts}/NUTS_{nuts}.pdf"
    shell:
        (
            "set -euo pipefail; "
            "TEX_DIR=$(dirname {input.tex_nuts}); "
            "TEX_BASE=NUTS_{wildcards.nuts}; "
            "PDFLATEX_BIN=/usr/bin/pdflatex; "
            "if [ ! -x \"$PDFLATEX_BIN\" ]; then PDFLATEX_BIN=$(command -v pdflatex); fi; "
            "\"$PDFLATEX_BIN\" -interaction=nonstopmode -halt-on-error -file-line-error -output-directory \"$TEX_DIR\" {input.tex_nuts} >/dev/null || "
            "(echo '[compile_tex_NUTS] First pdflatex pass failed. Showing log tail:'; tail -n 120 \"$TEX_DIR/$TEX_BASE.log\"; exit 1); "
            "\"$PDFLATEX_BIN\" -interaction=nonstopmode -halt-on-error -file-line-error -output-directory \"$TEX_DIR\" {input.tex_nuts} >/dev/null || "
            "(echo '[compile_tex_NUTS] Second pdflatex pass failed. Showing log tail:'; tail -n 120 \"$TEX_DIR/$TEX_BASE.log\"; exit 1); "
            "rm -f \"$TEX_DIR/$TEX_BASE.aux\" \"$TEX_DIR/$TEX_BASE.log\" \"$TEX_DIR/$TEX_BASE.out\""
        )


#################### get_tex_cover
#
# This rule generates a LaTeX cover file for one cutout/year/resource/NUTS level.
#
# Wildcards:
#   - cutout     [era5, ...]
#   - year       [2013, ...]
#   - resource   [onwind, solar]
#   - nuts       [NUTS2, NUTS3]

rule get_tex_cover:
    wildcard_constraints:
        nuts="NUTS2|NUTS3",
        resource="onwind|solar",
    threads:
        lambda w: get_rule_threads(
            "get_tex_cover",
            f"benchmarks/get_tex_cover/{w.cutout}/{w.resource}/{w.nuts}/get_tex_cover_{w.nuts}_{w.year}.tsv",
        )
    resources:
        mem_mb=lambda w: get_rule_mem_mb(
            "get_tex_cover",
            f"benchmarks/get_tex_cover/{w.cutout}/{w.resource}/{w.nuts}/get_tex_cover_{w.nuts}_{w.year}.tsv",
        )
    benchmark:
        "benchmarks/get_tex_cover/{cutout}/{resource}/{nuts}/get_tex_cover_{nuts}_{year}.tsv"
    message:
        "... [get_tex_cover] Generating LaTeX cover for cutout: {wildcards.cutout}, year: {wildcards.year}, resource: {wildcards.resource}, NUTS level: {wildcards.nuts}."
    input:
        template=lambda w: (
            "LaTex/template_cover_onwind.tex"
            if w.resource == "onwind"
            else f"LaTex/template_cover_{w.resource}.tex"
        )
    output:
        tex_cover="results/LaTex/{cutout}/{year}/{resource}/{nuts}/cover_{nuts}.tex"
    shell:
        (
            "python scripts/get_tex_cover.py "
            "--nuts {wildcards.nuts} "
            "--cutout {wildcards.cutout} "
            "--year {wildcards.year} "
            "--resource {wildcards.resource} "
            "--template {input.template}"
        )


#################### compile_tex_cover
